<?xml version="1.0" encoding="UTF-8" ?>

<process-application
        xmlns="http://www.camunda.org/schema/1.0/ProcessApplication">

    <!-- All BPMN resources belong to one archive. Separate scanning archives scan
         the same classpath and can deploy the complete bundle more than once. -->
    <process-archive name="businessprocesses">
        <process-engine>default</process-engine>
        <properties>
            <property name="isScanForProcessDefinitions">true</property>
        </properties>
    </process-archive>

</process-application>
